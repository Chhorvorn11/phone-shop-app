APP_NAME="Phone Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Set this to your own timezone so "today" and pickup dates match your shop (list: php.net/timezones)
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- Database: SQLite (easiest, no server needed) ----
# Create the file once:  Windows  type nul > database\database.sqlite   |   Mac/Linux  touch database/database.sqlite
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# ---- Or MySQL: comment out the two SQLite lines above and use these ----
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=phone_store
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Emails are written to storage/logs/laravel.log instead of being sent
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@phonestore.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
